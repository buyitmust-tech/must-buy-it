{%- liquid
  assign compare_total = 0
  for item in cart.items
    if item.variant.compare_at_price > item.variant.price
      assign line_compare = item.variant.compare_at_price | times: item.quantity
    else
      assign line_compare = item.original_line_price
    endif
    assign compare_total = compare_total | plus: line_compare
  endfor
  assign savings = compare_total | minus: cart.total_price
-%}
{%- for d in cart.cart_level_discount_applications -%}
  <div class="cart-savings"><span>🏷 {{ d.title }}</span><span>-{% render 'money', cents: d.total_allocated_amount %}</span></div>
{%- endfor -%}
{%- if savings > 0 -%}
  <div class="cart-savings"><span>חסכת בהזמנה הזו</span><span>{% render 'money', cents: savings %}</span></div>
{%- endif -%}
<div class="cart-subtotal"><span>סה״כ</span><span>{% render 'money', cents: cart.total_price %}</span></div>
<p class="cart-note-tax">כולל מע״מ. דמי משלוח וקודי הנחה יחושבו בקופה.</p>
