{%- comment -%}
  Category card: square image on top, title and product count below.
  Accepts: collection, title (optional), image (optional), sizes (optional)
{%- endcomment -%}
{%- assign tile_title = title | default: collection.title | default: 'קטגוריה' -%}
{%- assign tile_image = image | default: collection.featured_image -%}
<a href="{{ collection.url | default: '#' }}" class="collection-tile reveal">
  <span class="collection-tile__media">
    {%- if tile_image != blank -%}
      {{ tile_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: sizes, alt: tile_title }}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </span>
  <span class="collection-tile__body">
    <span class="collection-tile__text">
      <span class="collection-tile__title">{{ tile_title }}</span>
      {%- if collection.products_count > 0 -%}
        <span class="collection-tile__count">{{ collection.products_count }} מוצרים</span>
      {%- endif -%}
    </span>
    <span class="collection-tile__cta">{% render 'icon', name: 'arrow' %}</span>
  </span>
</a>
