      { "type": "range", "id": "border_radius", "label": "עיגול פינות כרטיסים", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 12 },
      { "type": "range", "id": "button_radius", "label": "עיגול פינות כפתורים", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" },
