      { "type": "text", "id": "sales_popup_names", "label": "שמות (מופרדים בפסיק)", "default": "נועה,דניאל,מיכל,יוסי,שירה,אורי,טל,רוני" },
      { "type": "text", "id": "sales_popup_cities", "label": "ערים (מופרדות בפסיק)", "default": "תל אביב,חיפה,ירושלים,באר שבע,ראשון לציון,נתניה,אשדוד,פתח תקווה" },
      { "type": "header", "content": "כרטיסי מוצר" },
      { "type": "checkbox", "id": "card_show_rating", "label": "הצג כוכבי דירוג בכרטיס מוצר", "info": "משתמש במטאפילד reviews.rating אם קיים", "default": true },
      { "type": "checkbox", "id": "card_show_quick_add", "label": "הצג כפתור הוספה מהירה לסל", "default": true },
      { "type": "checkbox", "id": "card_show_second_image", "label": "הצג תמונה שנייה במעבר עכבר", "default": true }
