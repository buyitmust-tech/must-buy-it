<div class="page-width">
  <div class="customer">
    <h1>איפוס סיסמה</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPass">סיסמה חדשה</label><input type="password" id="ResetPass" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPass2">אימות סיסמה</label><input type="password" id="ResetPass2" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--primary btn--full">שמירה</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "איפוס סיסמה", "settings": [] }
{% endschema %}
