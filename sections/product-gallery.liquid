{%- comment -%}
  Mosaic of the product's extra images (2nd image onward). Content-agnostic,
  so it works even when we don't know what each image shows.
  Hidden when the product has fewer than section.settings.min_images images.
{%- endcomment -%}
{%- liquid
  assign images = product.media | where: 'media_type', 'image'
  assign count = images.size | minus: 1
  if count > section.settings.max_images
    assign count = section.settings.max_images
  endif
-%}
{%- if images.size > section.settings.min_images -%}
  <section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
    <div class="page-width">
      <div class="section-header">
        <h2>{{ product.metafields.page.gallery_heading.value | default: section.settings.heading }}</h2>
      </div>
      <div class="mosaic mosaic--{{ count | at_most: 5 }}">
        {%- for media in images offset: 1 limit: count -%}
          <div class="mosaic__item reveal">
            {{ media.preview_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 750px) 33vw, 50vw', alt: media.alt | default: product.title }}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "מוצר: גלריית תמונות",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת ברירת מחדל", "default": "מכל זווית" },
    { "type": "range", "id": "min_images", "label": "הצג רק כשיש יותר מ- תמונות", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "max_images", "label": "מקסימום תמונות", "min": 3, "max": 9, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false }
  ]
}
{% endschema %}
