{%- assign s = section.settings -%}
<div class="page-width">
  <div class="collection-hero">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank and s.show_description -%}
      <div class="collection-hero__desc rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by s.per_page -%}
    <div class="toolbar">
      {%- if s.enable_filters and collection.filters.size > 0 -%}
        <form class="filters" data-filter-form>
          {%- for filter in collection.filters -%}
            <details>
              <summary>
                {{ filter.label }}
                {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
              </summary>
              <div class="filters__panel">
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    {%- for value in filter.values -%}
                      <label>
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                        {{ value.label }} <span class="muted">({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                  {%- when 'price_range' -%}
                    <div class="price-range">
                      <input class="input" type="number" name="{{ filter.min_value.param_name }}" placeholder="מ-" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" min="0">
                      <input class="input" type="number" name="{{ filter.max_value.param_name }}" placeholder="עד {{ filter.range_max | money_without_currency | replace: ',', '' }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" min="0">
                    </div>
                    <button type="submit" class="btn btn--dark btn--full" style="margin-top:.6rem;min-height:40px;">החל</button>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
          <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
        </form>
      {%- else -%}
        <span class="muted">{{ collection.products_count }} מוצרים</span>
      {%- endif -%}

      <label class="muted" style="display:flex;align-items:center;gap:.5rem;">
        מיון:
        <select data-sort aria-label="מיון">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
      </label>
    </div>

    {%- assign has_active = false -%}
    {%- for filter in collection.filters -%}{%- if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign has_active = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_active -%}
      <div class="active-filters">
        {%- for filter in collection.filters -%}
          {%- for v in filter.active_values -%}<a href="{{ v.url_to_remove }}">{{ v.label }} ✕</a>{%- endfor -%}
        {%- endfor -%}
        <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="link">נקה הכל</a>
      </div>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <div class="grid" style="--cols: {{ s.columns }}; --cols-tablet: 3; --cols-mobile: {{ s.columns_mobile }};">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, ratio: s.ratio, show_vendor: s.show_vendor %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="cart-empty">
        <h3>לא נמצאו מוצרים</h3>
        <a href="{{ collection.url }}" class="btn btn--secondary">ניקוי סינון</a>
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav aria-label="עמודים">
        <ul class="pagination">
          {%- if paginate.previous -%}<li><a href="{{ paginate.previous.url }}" aria-label="הקודם">›</a></li>{%- endif -%}
          {%- for part in paginate.parts -%}
            <li>
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}<span class="is-current" aria-current="page">{{ part.title }}</span>
              {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
            </li>
          {%- endfor -%}
          {%- if paginate.next -%}<li><a href="{{ paginate.next.url }}" aria-label="הבא">‹</a></li>{%- endif -%}
        </ul>
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>
<div style="height: 3rem;"></div>

{% schema %}
{
  "name": "עמוד קולקציה",
  "settings": [
    { "type": "range", "id": "per_page", "label": "מוצרים בעמוד", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "עמודות בדסקטופ", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "עמודות במובייל", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "2" },
    { "type": "select", "id": "ratio", "label": "יחס תמונה", "options": [ { "value": "1", "label": "ריבוע" }, { "value": "0.8", "label": "לאורך" }, { "value": "1.25", "label": "לרוחב" } ], "default": "1" },
    { "type": "checkbox", "id": "enable_filters", "label": "הפעל סינון", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "הצג תיאור קולקציה", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "הצג מותג", "default": false }
  ]
}
{% endschema %}
