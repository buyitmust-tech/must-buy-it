{%- assign s = section.settings -%}
<section class="section section--alt">
  <div class="page-width">
    <div class="section-header"><h2>{{ s.heading }}</h2></div>
    {%- if recommendations.performed? and recommendations.products_count > 0 -%}
      <div class="grid" style="--cols: {{ s.columns }}; --cols-tablet: 3; --cols-mobile: 2;">
        {%- for product in recommendations.products limit: s.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent=related"></div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var el = document.querySelector('#shopify-section-{{ section.id }} [data-recommendations]');
    if (!el) return;
    fetch(el.dataset.url)
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.querySelector('.shopify-section');
        var grid = fresh && fresh.querySelector('.grid');
        if (grid) {
          el.replaceWith(grid);
          grid.querySelectorAll('.reveal').forEach(function (n) { n.classList.add('is-in'); });
        } else {
          document.getElementById('shopify-section-{{ section.id }}').hidden = true;
        }
      });
  })();
</script>

{% schema %}
{
  "name": "מוצרים קשורים",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "לקוחות שקנו את זה קנו גם" },
    { "type": "range", "id": "limit", "label": "מספר מוצרים", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "עמודות", "min": 2, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}
