<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="grid" style="--cols: {{ section.settings.columns }}; --cols-tablet: 3; --cols-mobile: 2;">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a href="{{ c.url | default: '#' }}" class="collection-tile reveal" style="--ratio: {{ section.settings.ratio }};" {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: c.featured_image -%}
          {%- if img != blank -%}
            {{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: c.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="collection-tile__label">{{ block.settings.title | default: c.title | default: 'קטגוריה' }} {% render 'icon', name: 'arrow' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "רשימת קטגוריות",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "קנו לפי קטגוריה" },
    { "type": "range", "id": "columns", "label": "עמודות בדסקטופ", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "ratio", "label": "יחס תמונה", "options": [ { "value": "1", "label": "ריבוע" }, { "value": "0.8", "label": "לאורך" }, { "value": "1.25", "label": "לרוחב" } ], "default": "1" },
    { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "קטגוריה",
      "settings": [
        { "type": "collection", "id": "collection", "label": "קולקציה" },
        { "type": "text", "id": "title", "label": "כותרת (אופציונלי)" },
        { "type": "image_picker", "id": "image", "label": "תמונה (אופציונלי)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "רשימת קטגוריות",
      "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ]
    }
  ]
}
{% endschema %}
