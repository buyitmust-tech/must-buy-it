<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="grid collection-grid" style="--cols: {{ section.settings.columns }}; --cols-tablet: {{ section.settings.columns | at_most: 4 }}; --cols-mobile: 2;">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- render 'collection-tile', collection: block.settings.collection, title: block.settings.title, image: block.settings.image, sizes: '(min-width: 990px) 20vw, (min-width: 750px) 25vw, 50vw' -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "רשימת קטגוריות",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "קנו לפי קטגוריה" },
    { "type": "range", "id": "columns", "label": "עמודות בדסקטופ", "min": 2, "max": 6, "step": 1, "default": 4 },
        { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "קטגוריה",
      "settings": [
        { "type": "collection", "id": "collection", "label": "קולקציה" },
        { "type": "text", "id": "title", "label": "כותרת (אופציונלי)" },
        { "type": "image_picker", "id": "image", "label": "תמונה (אופציונלי)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "רשימת קטגוריות",
      "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ]
    }
  ]
}
{% endschema %}
