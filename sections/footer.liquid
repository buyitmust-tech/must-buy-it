{%- assign menu_blocks = section.blocks | where: 'type', 'menu' -%}
<footer class="footer" style="--footer-bg: {{ section.settings.bg }}; --footer-fg: {{ section.settings.fg }};">
  <div class="page-width">
    <div class="footer__grid" style="--cols: {{ menu_blocks.size | at_least: 1 }};">
      <div>
        <h3>{{ section.settings.heading | default: shop.name }}</h3>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        <div class="socials">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
        </div>
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'menu' -%}
              <h3>{{ block.settings.heading | default: block.settings.menu.title }}</h3>
              <ul>
                {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
              </ul>
            {%- when 'text' -%}
              <h3>{{ block.settings.heading }}</h3>
              <div class="rte">{{ block.settings.text }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. כל הזכויות שמורות.</span>
      {%- if section.settings.show_payment -%}
        <ul class="payment-icons" aria-label="אמצעי תשלום">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "פוטר",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת" },
    { "type": "richtext", "id": "text", "label": "טקסט", "default": "<p>המוצרים הכי שווים, במחירים הכי טובים. משלוח מהיר לכל הארץ ושירות לקוחות אמיתי.</p>" },
    { "type": "checkbox", "id": "show_payment", "label": "הצג אייקוני תשלום", "default": true },
    { "type": "color", "id": "bg", "label": "רקע", "default": "#0b1220" },
    { "type": "color", "id": "fg", "label": "טקסט", "default": "#e5e7eb" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "תפריט",
      "settings": [
        { "type": "text", "id": "heading", "label": "כותרת" },
        { "type": "link_list", "id": "menu", "label": "תפריט", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "טקסט",
      "settings": [
        { "type": "text", "id": "heading", "label": "כותרת", "default": "שירות לקוחות" },
        { "type": "richtext", "id": "text", "label": "טקסט", "default": "<p>זמינים בוואטסאפ ובמייל<br>א׳-ה׳ 9:00-18:00</p>" }
      ]
    }
  ]
}
{% endschema %}
