{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign ratio = s.media_ratio
  assign mb = product.metafields.page
-%}

<div class="page-width" data-product-root>
  <nav class="breadcrumbs" aria-label="breadcrumbs">
    <a href="{{ routes.root_url }}">דף הבית</a> /
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a> /
    {%- endif -%}
    <span>{{ product.title }}</span>
  </nav>

  <div class="product">
    {%- comment -%} ========== Gallery ========== {%- endcomment -%}
    <div class="product__media-wrap">
      <div class="gallery__main" style="--ratio: {{ ratio }};">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="gallery__slide" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- if forloop.first -%}
                    {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 750, 1000, 1300, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                  {%- else -%}
                    {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500, 750, 1000, 1300, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                  {%- endif -%}
                {%- when 'video' -%}
                  {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
                {%- when 'external_video' -%}
                  <div class="media-iframe">{{ media | external_video_tag }}</div>
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="gallery__dots" aria-hidden="true">
          {%- for media in product.media -%}<span{% if forloop.first %} class="is-active"{% endif %}></span>{%- endfor -%}
        </div>
        <div class="gallery__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="gallery__thumb{% if forloop.first %} is-active{% endif %}" data-target="{{ media.id }}" aria-label="תמונה {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ========== Info ========== {%- endcomment -%}
    <div class="product__info" id="ProductInfo">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'vendor' -%}
            <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>

          {%- when 'title' -%}
            <div class="product__heading" {{ block.shopify_attributes }}>
              {%- if mb.badge.value != blank -%}<span class="badge badge--sale product__badge">{{ mb.badge.value }}</span>{%- endif -%}
              <h1 class="product__title">{{ product.title }}</h1>
              {%- if mb.hook.value != blank -%}<p class="product__hook">{{ mb.hook.value }}</p>{%- endif -%}
            </div>

          {%- when 'rating' -%}
            <div {{ block.shopify_attributes }}>
              {%- if product.metafields.reviews.rating.value != blank -%}
                {% render 'stars', product: product, show_number: true, label: 'ביקורות' %}
              {%- elsif block.settings.fallback_rating != blank -%}
                {% render 'stars', rating: block.settings.fallback_rating, count: block.settings.fallback_count, show_number: true, label: 'ביקורות' %}
              {%- endif -%}
            </div>

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant, size: 'lg', save_style: block.settings.save_style %}
              {%- if block.settings.show_tax_note -%}<p class="product__tax">כולל מע״מ. {% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}" class="link">משלוח</a> יחושב בקופה.{% endif %}</p>{%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'benefits' -%}
            {%- if mb.benefits.value != blank -%}
              {%- assign lines = mb.benefits.value -%}
            {%- else -%}
              {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
            {%- endif -%}
            {%- if lines.size > 0 -%}
              <ul class="benefits" {{ block.shopify_attributes }}>
                {%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'viewers' -%}
            <p class="viewers" data-viewers data-min="{{ block.settings.min }}" data-max="{{ block.settings.max }}" {{ block.shopify_attributes }}>
              {% render 'icon', name: 'eye' %} <span><strong data-viewers-count>{{ block.settings.min }}</strong> אנשים צופים במוצר הזה כרגע</span>
            </p>

          {%- when 'inventory' -%}
            {%- liquid
              assign qty = current_variant.inventory_quantity
              assign tracked = false
              if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny'
                assign tracked = true
              endif
              assign show_low = false
              if tracked and qty > 0 and qty <= block.settings.threshold
                assign show_low = true
              endif
              assign bar_pct = qty | times: 100 | divided_by: block.settings.threshold | at_least: 8
            -%}
            <div class="urgency-wrap" data-stock data-threshold="{{ block.settings.threshold }}" {{ block.shopify_attributes }}{% unless show_low %} hidden{% endunless %}>
              <p class="urgency urgency--stock"><span class="urgency__dot"></span> מהרו! נשארו רק <span data-stock-qty>{{ qty }}</span> יחידות במלאי</p>
              <div class="stock-bar"><span style="width: {{ bar_pct }}%;"></span></div>
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variants" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign oi = forloop.index0 -%}
                  {%- if block.settings.style == 'bundles' and product.options.size == 1 -%}
                    {%- liquid
                      assign popular = mb.popular_variant.value | default: block.settings.popular_index | plus: 0
                    -%}
                    <fieldset class="variant-group">
                      <legend>{{ block.settings.bundle_heading | default: option.name }}</legend>
                      <div class="bundles">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign v = product.variants[forloop.index0]
                            assign label_main = value | split: '–' | first | split: ' - ' | first | strip
                            assign label_sub = value | remove_first: label_main | remove_first: '–' | remove_first: ' - ' | strip
                            assign is_popular = false
                            if forloop.index == popular
                              assign is_popular = true
                            endif
                            assign v_compare = v.compare_at_price
                          -%}
                          <input type="radio" id="Opt-{{ section.id }}-{{ oi }}-{{ forloop.index0 }}" name="opt-{{ section.id }}-{{ oi }}" value="{{ value | escape }}" data-option-index="{{ oi }}"{% if option.selected_value == value %} checked{% endif %}>
                          <label class="bundle{% if is_popular %} bundle--popular{% endif %}" for="Opt-{{ section.id }}-{{ oi }}-{{ forloop.index0 }}">
                            {%- if is_popular and block.settings.popular_label != blank -%}<span class="bundle__tag">{{ block.settings.popular_label }}</span>{%- endif -%}
                            <span class="bundle__radio" aria-hidden="true"></span>
                            <span class="bundle__text">
                              <strong>{{ label_main }}</strong>
                              {%- if label_sub != blank -%}<span class="bundle__save">{{ label_sub }}</span>{%- endif -%}
                            </span>
                            <span class="bundle__price">
                              <strong>{% render 'money', cents: v.price %}</strong>
                              {%- if v_compare > v.price -%}<s>{% render 'money', cents: v_compare %}</s>{%- endif -%}
                            </span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- elsif block.settings.style == 'dropdown' -%}
                    <div class="field">
                      <label for="Option-{{ section.id }}-{{ oi }}">{{ option.name }}</label>
                      <select id="Option-{{ section.id }}-{{ oi }}" class="variant-select" data-option-index="{{ oi }}">
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- else -%}
                    <fieldset class="variant-group" style="margin-bottom: .9rem;">
                      <legend>{{ option.name }}: <span data-selected-value="{{ oi }}">{{ option.selected_value }}</span></legend>
                      <div class="variant-pills">
                        {%- for value in option.values -%}
                          <input type="radio" id="Opt-{{ section.id }}-{{ oi }}-{{ forloop.index0 }}" name="opt-{{ section.id }}-{{ oi }}" value="{{ value | escape }}" data-option-index="{{ oi }}"{% if option.selected_value == value %} checked{% endif %}>
                          <label for="Opt-{{ section.id }}-{{ oi }}-{{ forloop.index0 }}">{{ value }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, data-product-form: '', data-ajax-cart: '', class: 'buy-buttons' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <div class="buy-row">
                  {%- if block.settings.show_quantity -%}
                    <div class="qty">
                      <button type="button" data-qty-btn="minus" aria-label="הפחת כמות">−</button>
                      <input type="number" name="quantity" value="1" min="1" aria-label="כמות">
                      <button type="button" data-qty-btn="plus" aria-label="הוסף כמות">+</button>
                    </div>
                  {%- endif -%}
                  <button
                    type="submit"
                    name="add"
                    class="btn btn--primary btn--lg{% if block.settings.pulse %} btn--pulse{% endif %}"
                    data-atc
                    data-label="{{ block.settings.atc_label | escape }}"
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-atc-label>{%- if current_variant.available -%}{{ block.settings.atc_label }}{%- else -%}אזל מהמלאי{%- endif -%}</span>
                  </button>
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'delivery' -%}
            <div class="delivery-box" data-delivery data-min="{{ block.settings.min_days }}" data-max="{{ block.settings.max_days }}" {{ block.shopify_attributes }}>
              {% render 'icon', name: 'truck' %}
              <div>{{ block.settings.prefix }} <strong><span data-delivery-from></span> – <span data-delivery-to></span></strong></div>
            </div>

          {%- when 'trust_icons' -%}
            <div class="product-trust" {{ block.shopify_attributes }}>
              <div>{% render 'icon', name: 'truck' %}{{ block.settings.t1 }}</div>
              <div>{% render 'icon', name: 'return' %}{{ block.settings.t2 }}</div>
              <div>{% render 'icon', name: 'lock' %}{{ block.settings.t3 }}</div>
            </div>

          {%- when 'payment_icons' -%}
            <ul class="payment-icons" style="justify-content:center;" {{ block.shopify_attributes }}>
              {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
            </ul>

          {%- when 'guarantee' -%}
            <div class="guarantee" {{ block.shopify_attributes }}>
              <span class="guarantee__seal">{{ block.settings.seal }}</span>
              <div>
                <strong>{{ block.settings.heading }}</strong>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>

          {%- when 'bundle_note' -%}
            {%- assign note = mb.offer_note.value | default: block.settings.text -%}
            {%- if note != blank -%}<div class="bundle-note" {{ block.shopify_attributes }}>{{ note }}</div>{%- endif -%}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="accordion" {{ block.shopify_attributes }}>
                <details{% if block.settings.open %} open{% endif %}>
                  <summary><span class="accordion__title">{{ block.settings.heading }}</span></summary>
                  <div class="accordion__content rte">{{ product.description }}</div>
                </details>
              </div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            <div class="accordion" style="border-top: 0;" {{ block.shopify_attributes }}>
              <details>
                <summary><span class="accordion__title">{% render 'icon', name: block.settings.icon %} {{ block.settings.heading }}</span></summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>
            </div>

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Data for JS {%- endcomment -%}
  <script type="application/json" data-product-json>
    {
      "id": {{ product.id }},
      "options": {{ product.options | json }},
      "variants": {{ product.variants | json }},
      "inventory": {
        {%- for v in product.variants -%}
          "{{ v.id }}": {% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    }
  </script>
</div>

{%- if s.sticky_atc -%}
  <div class="sticky-atc" id="StickyAtc" aria-hidden="true">
    <div class="page-width sticky-atc__inner">
      {%- if featured -%}{{ featured.preview_image | image_url: width: 120 | image_tag: class: 'sticky-atc__img', loading: 'lazy', alt: '' }}{%- endif -%}
      <div class="sticky-atc__info">
        <div class="sticky-atc__title">{{ product.title }}</div>
        {% render 'price', product: product, variant: current_variant %}
      </div>
      <button type="button" class="btn btn--primary" data-sticky-submit data-atc data-label="{{ s.sticky_label | escape }}"{% unless current_variant.available %} disabled{% endunless %}>
        <span data-atc-label>{%- if current_variant.available -%}{{ s.sticky_label }}{%- else -%}אזל מהמלאי{%- endif -%}</span>
      </button>
    </div>
  </div>
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.media.size > 0 -%}
      "image": [
        {%- for media in product.media limit: 6 -%}
          {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
    {%- endif -%}
    {%- if product.type != blank -%}"category": {{ product.type | json }},{%- endif -%}
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    {%- if current_variant.sku != blank -%}"sku": {{ current_variant.sku | json }},{%- endif -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for v in product.variants -%}
        {
          "@type": "Offer",
          {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
          {%- unless product.has_only_default_variant -%}"name": {{ product.title | append: ' – ' | append: v.title | json }},{%- endunless -%}
          "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "seller": { "@type": "Organization", "name": {{ shop.name | json }} },
          "price": {{ v.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: v.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "דף הבית", "item": {{ request.origin | append: routes.root_url | json }} },
      {%- if collection -%}
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- else -%}
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- endif -%}
    ]
  }
</script>

{% schema %}
{
  "name": "עמוד מוצר",
  "class": "section-main-product",
  "settings": [
    { "type": "select", "id": "media_ratio", "label": "יחס תמונות", "options": [ { "value": "1", "label": "ריבוע" }, { "value": "0.8", "label": "לאורך" }, { "value": "1.25", "label": "לרוחב" } ], "default": "1" },
    { "type": "checkbox", "id": "sticky_atc", "label": "פס \"הוספה לסל\" נדבק בגלילה", "default": true },
    { "type": "text", "id": "sticky_label", "label": "טקסט כפתור נדבק", "default": "הוספה לסל" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "מותג", "limit": 1 },
    { "type": "title", "name": "כותרת", "limit": 1 },
    {
      "type": "rating",
      "name": "דירוג כוכבים",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "מציג אוטומטית דירוג מאפליקציית ביקורות (מטאפילד reviews.rating). אם אין — יוצג דירוג ברירת המחדל." },
        { "type": "text", "id": "fallback_rating", "label": "דירוג ברירת מחדל", "info": "השאירו ריק כדי להציג כוכבים רק מביקורות אמיתיות" },
        { "type": "text", "id": "fallback_count", "label": "מספר ביקורות ברירת מחדל" }
      ]
    },
    {
      "type": "price",
      "name": "מחיר",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "save_style", "label": "תצוגת חסכון", "options": [ { "value": "percent", "label": "אחוזים (30% הנחה)" }, { "value": "amount", "label": "סכום (חסכון של ₪50)" } ], "default": "percent" },
        { "type": "checkbox", "id": "show_tax_note", "label": "הצג \"כולל מע״מ\"", "default": true }
      ]
    },
    { "type": "text", "name": "טקסט", "settings": [ { "type": "richtext", "id": "text", "label": "טקסט", "default": "<p>תיאור קצר ומשכנע של המוצר — מה הבעיה שהוא פותר ולמה הוא חובה.</p>" } ] },
    { "type": "benefits", "name": "רשימת יתרונות", "settings": [ { "type": "textarea", "id": "items", "label": "יתרונות (שורה לכל יתרון)", "default": "איכות פרימיום שמחזיקה שנים\nמתאים לשימוש יומיומי\nמגיע באריזת מתנה מהודרת" } ] },
    {
      "type": "viewers",
      "name": "צופים כעת",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "min", "label": "מינימום", "min": 2, "max": 50, "step": 1, "default": 9 },
        { "type": "range", "id": "max", "label": "מקסימום", "min": 5, "max": 100, "step": 1, "default": 27 }
      ]
    },
    {
      "type": "inventory",
      "name": "מלאי נמוך",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "מוצג רק כשהמלאי במעקב והכמות נמוכה מהסף." },
        { "type": "range", "id": "threshold", "label": "הצג כשהמלאי מתחת ל-", "min": 1, "max": 50, "step": 1, "default": 10 }
      ]
    },
    {
      "type": "variant_picker",
      "name": "בחירת וריאנט",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "style", "label": "סגנון", "options": [ { "value": "bundles", "label": "כרטיסי חבילות (מומלץ ל-1/2/3 יחידות)" }, { "value": "pills", "label": "כפתורים" }, { "value": "dropdown", "label": "רשימה נפתחת" } ], "default": "pills", "info": "כרטיסי חבילות פועלים במוצרים עם אפשרות אחת בלבד" },
        { "type": "text", "id": "bundle_heading", "label": "כותרת מעל כרטיסי חבילות", "default": "בחרו חבילה" },
        { "type": "range", "id": "popular_index", "label": "חבילה מסומנת כפופולרית (מס׳)", "min": 0, "max": 5, "step": 1, "default": 2, "info": "0 = ללא. ניתן לדרוס במוצר עם מטאפילד page.popular_variant" },
        { "type": "text", "id": "popular_label", "label": "תווית לחבילה הפופולרית", "default": "⭐ הכי משתלם" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "כפתורי קנייה",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "atc_label", "label": "טקסט כפתור", "default": "הוספה לסל" },
        { "type": "checkbox", "id": "show_quantity", "label": "הצג בחירת כמות", "default": true },
        { "type": "checkbox", "id": "pulse", "label": "אנימציית פעימה", "default": false },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "הצג כפתור \"קנה עכשיו\"", "info": "כפתורי תשלום מהיר (Apple Pay, Google Pay וכו')", "default": true }
      ]
    },
    {
