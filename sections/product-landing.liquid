{%- comment -%}
  Landing-page section for a dedicated product template.
  Each block is one band of the page. Images are picked by their position in
  the product's media (1 = first image), so the copy lives in the template and
  the images stay on the product.
{%- endcomment -%}
{%- assign variant = product.selected_or_first_available_variant -%}
<div class="pl" id="ProductLanding-{{ section.id }}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign img = blank
      if block.settings.image_index > 0
        assign img_i = block.settings.image_index | minus: 1
        assign img = product.media[img_i].preview_image
      endif
    -%}
    <section class="pl-band pl-band--{{ block.type }}{% if block.settings.alt_bg %} pl-band--alt{% endif %}" {{ block.shopify_attributes }}>
      <div class="page-width">
        {%- case block.type -%}

          {%- when 'split' -%}
            <div class="pl-split{% if block.settings.reverse %} pl-split--reverse{% endif %}">
              <div class="pl-split__media">
                {%- if img != blank -%}
                  {{ img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 50vw, 100vw', alt: img.alt }}
                {%- endif -%}
              </div>
              <div class="pl-split__body">
                {%- if block.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
                <h2 class="pl-h2">{{ block.settings.heading }}</h2>
                {%- if block.settings.text != blank -%}<div class="pl-text rte">{{ block.settings.text }}</div>{%- endif -%}
                {%- assign lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
                {%- if block.settings.bullets != blank -%}
                  <ul class="pl-checks">
                    {%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </div>

          {%- when 'steps' -%}
            <div class="pl-head">
              {%- if block.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
              <h2 class="pl-h2">{{ block.settings.heading }}</h2>
            </div>
            <div class="pl-steps-wrap">
              {%- if img != blank -%}
                <div class="pl-steps__media">{{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 40vw, 100vw', alt: img.alt }}</div>
              {%- endif -%}
              <ol class="pl-steps">
                {%- assign steps = block.settings.steps | newline_to_br | split: '<br />' -%}
                {%- for s in steps -%}
                  {%- assign parts = s | strip | split: '|' -%}
                  {%- if parts.size > 0 and parts[0] != blank -%}
                    <li><strong>{{ parts[0] | strip }}</strong>{%- if parts[1] -%}<span>{{ parts[1] | strip }}</span>{%- endif -%}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ol>
            </div>

          {%- when 'compare' -%}
            <div class="pl-head"><h2 class="pl-h2">{{ block.settings.heading }}</h2></div>
            <div class="pl-compare" role="table">
              <div class="pl-compare__row pl-compare__row--head" role="row">
                <span role="columnheader"></span>
                <span role="columnheader" class="pl-compare__us">{{ block.settings.us_label }}</span>
                <span role="columnheader">{{ block.settings.them_label }}</span>
              </div>
              {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
              {%- for r in rows -%}
                {%- assign c = r | strip | split: '|' -%}
                {%- if c.size > 2 -%}
                  <div class="pl-compare__row" role="row">
                    <span role="cell">{{ c[0] | strip }}</span>
                    {%- assign us = c[1] | strip -%}{%- assign them = c[2] | strip -%}
                    <span role="cell" class="pl-compare__us">{%- if us == '+' -%}<i class="pl-yes" aria-label="כן">✓</i>{%- elsif us == '-' -%}<i class="pl-no" aria-label="לא">✕</i>{%- else -%}{{ us }}{%- endif -%}</span>
                    <span role="cell">{%- if them == '+' -%}<i class="pl-yes" aria-label="כן">✓</i>{%- elsif them == '-' -%}<i class="pl-no" aria-label="לא">✕</i>{%- else -%}{{ them }}{%- endif -%}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'tiles' -%}
            <div class="pl-head">
              {%- if block.settings.eyebrow != blank -%}<p class="pl-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
              <h2 class="pl-h2">{{ block.settings.heading }}</h2>
            </div>
            <ul class="pl-tiles">
              {%- assign tiles = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- for t in tiles -%}
                {%- assign p = t | strip | split: '|' -%}
                {%- if p.size > 1 -%}
                  <li><span class="pl-tiles__icon" aria-hidden="true">{{ p[0] | strip }}</span><strong>{{ p[1] | strip }}</strong>{%- if p[2] -%}<span>{{ p[2] | strip }}</span>{%- endif -%}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'images' -%}
            {%- if block.settings.heading != blank -%}<div class="pl-head"><h2 class="pl-h2">{{ block.settings.heading }}</h2></div>{%- endif -%}
            <div class="pl-images">
              {%- assign idxs = block.settings.indexes | split: ',' -%}
              {%- for i in idxs -%}
                {%- assign n = i | strip | plus: 0 | minus: 1 -%}
                {%- assign m = product.media[n].preview_image -%}
                {%- if m != blank -%}<div class="pl-images__item">{{ m | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 750px) 33vw, 80vw', alt: m.alt }}</div>{%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'specs' -%}
            <div class="pl-head"><h2 class="pl-h2">{{ block.settings.heading }}</h2></div>
            <dl class="pl-specs">
              {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
              {%- for r in rows -%}
                {%- assign c = r | strip | split: '|' -%}
                {%- if c.size > 1 -%}<div><dt>{{ c[0] | strip }}</dt><dd>{{ c[1] | strip }}</dd></div>{%- endif -%}
              {%- endfor -%}
            </dl>

          {%- when 'faq' -%}
            <div class="pl-head"><h2 class="pl-h2">{{ block.settings.heading }}</h2></div>
            <div class="pl-faq">
              {%- assign rows = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- for r in rows -%}
                {%- assign c = r | strip | split: '|' -%}
                {%- if c.size > 1 -%}
                  <details><summary>{{ c[0] | strip }}</summary><div class="pl-faq__a">{{ c[1] | strip }}</div></details>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'offer' -%}
            <div class="pl-offer">
              {%- if img != blank -%}
                <div class="pl-offer__media">{{ img | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 750px) 35vw, 80vw', alt: img.alt }}</div>
              {%- endif -%}
              <div class="pl-offer__body">
                <h2 class="pl-h2">{{ block.settings.heading }}</h2>
                <div class="pl-offer__price">
                  <span class="pl-offer__now">{% render 'money', cents: variant.price %}</span>
                  {%- if variant.compare_at_price > variant.price -%}
                    <s class="pl-offer__was">{% render 'money', cents: variant.compare_at_price %}</s>
                  {%- endif -%}
                </div>
                {%- if block.settings.price_note != blank -%}<p class="pl-offer__note">{{ block.settings.price_note }}</p>{%- endif -%}
                {%- assign lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
                {%- if block.settings.bullets != blank -%}
                  <ul class="pl-checks">
                    {%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
                  </ul>
                {%- endif -%}
                {%- if variant.available -%}
                  {%- form 'product', product, class: 'pl-offer__form' -%}
                    <input type="hidden" name="id" value="{{ variant.id }}">
                    <button type="submit" class="btn btn--primary btn--lg btn--pulse pl-offer__btn">{{ block.settings.button_label }}</button>
                  {%- endform -%}
                {%- else -%}
                  <button type="button" class="btn btn--lg pl-offer__btn" disabled>אזל מהמלאי</button>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}<p class="pl-offer__sub">{{ block.settings.subtext }}</p>{%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      </div>
    </section>
  {%- endfor -%}
</div>

<style>
  #ProductLanding-{{ section.id }} .pl-band { padding: clamp(2.5rem, 6vw, 4.5rem) 0; }
  #ProductLanding-{{ section.id }} .pl-band--alt { background: var(--color-bg-alt); }
  .pl-head { text-align: center; max-width: 720px; margin: 0 auto 2rem; }
  .pl-eyebrow { display: inline-block; color: var(--color-accent); font-weight: 700; font-size: .85rem; letter-spacing: .04em; margin: 0 0 .5rem; }
  .pl-h2 { font-size: clamp(1.5rem, 3.2vw, 2.2rem); line-height: 1.2; margin: 0 0 1rem; }
  .pl-text { font-size: 1.05rem; line-height: 1.75; color: var(--color-muted); }
  .pl-text p { margin: 0 0 .8rem; }
  .pl-checks { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: .65rem; }
  .pl-checks li { display: flex; gap: .6rem; align-items: flex-start; line-height: 1.5; }
  .pl-checks li::before { content: "✓"; flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--color-accent); color: var(--color-accent-contrast); font-size: .8rem; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-top: .1rem; }

  .pl-split { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 750px) { .pl-split { grid-template-columns: 1fr 1fr; gap: 4rem; } .pl-split--reverse .pl-split__media { order: 2; } }
  .pl-split__media img, .pl-steps__media img, .pl-offer__media img, .pl-images img { width: 100%; height: auto; display: block; border-radius: var(--radius); }

  .pl-steps-wrap { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 750px) { .pl-steps-wrap { grid-template-columns: 1fr 1.1fr; gap: 3.5rem; } }
  .pl-steps { list-style: none; counter-reset: plstep; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .pl-steps li { counter-increment: plstep; position: relative; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem 1.1rem; padding-inline-start: 4rem; display: grid; gap: .25rem; }
  .pl-band--alt .pl-steps li { background: var(--color-bg); }
  .pl-steps li::before { content: counter(plstep); position: absolute; inset-inline-start: 1rem; top: 1rem; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--color-accent); color: var(--color-accent-contrast); font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .pl-steps strong { font-size: 1.05rem; }
  .pl-steps span { color: var(--color-muted); line-height: 1.6; }

  .pl-compare { max-width: 760px; margin: 0 auto; border: 1px solid var(--color-border); border-radius: var(--radius); overflow: hidden; background: var(--color-bg); }
  .pl-compare__row { display: grid; grid-template-columns: 1fr 7rem 7rem; align-items: center; border-top: 1px solid var(--color-border); }
  .pl-compare__row:first-child { border-top: 0; }
  .pl-compare__row > span { padding: .85rem 1rem; text-align: center; }
  .pl-compare__row > span:first-child { text-align: start; font-weight: 600; }
  .pl-compare__row--head { font-weight: 800; font-size: .9rem; background: var(--color-bg-alt); }
  .pl-compare__us { background: color-mix(in srgb, var(--color-accent) 8%, transparent); }
  .pl-compare__row--head .pl-compare__us { color: var(--color-accent); }
  .pl-yes, .pl-no { font-style: normal; font-weight: 800; font-size: 1.1rem; }
  .pl-yes { color: var(--color-success, #16a34a); }
  .pl-no { color: var(--color-muted); }
  @media (max-width: 600px) { .pl-compare__row { grid-template-columns: 1fr 4.5rem 4.5rem; font-size: .9rem; } .pl-compare__row > span { padding: .7rem .5rem; } }

  .pl-tiles { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .pl-tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .pl-tiles li { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.25rem 1rem; text-align: center; display: grid; gap: .35rem; justify-items: center; }
  .pl-tiles__icon { font-size: 1.8rem; line-height: 1; }
  .pl-tiles span:last-child { color: var(--color-muted); font-size: .92rem; line-height: 1.5; }

  .pl-images { display: grid; gap: 1rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 749px) { .pl-images { grid-auto-flow: column; grid-auto-columns: 78%; grid-template-columns: none; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .5rem; } .pl-images__item { scroll-snap-align: center; } }

  .pl-specs { max-width: 640px; margin: 0 auto; display: grid; gap: 0; border: 1px solid var(--color-border); border-radius: var(--radius); overflow: hidden; background: var(--color-bg); }
  .pl-specs div { display: grid; grid-template-columns: 40% 1fr; border-top: 1px solid var(--color-border); }
  .pl-specs div:first-child { border-top: 0; }
  .pl-specs dt, .pl-specs dd { margin: 0; padding: .8rem 1rem; }
  .pl-specs dt { font-weight: 700; background: var(--color-bg-alt); }

  .pl-faq { max-width: 760px; margin: 0 auto; display: grid; gap: .6rem; }
  .pl-faq details { border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-bg); }
  .pl-faq summary { cursor: pointer; padding: 1rem 1.1rem; font-weight: 700; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .pl-faq summary::-webkit-details-marker { display: none; }
  .pl-faq summary::after { content: "+"; font-size: 1.3rem; line-height: 1; color: var(--color-accent); flex: none; }
  .pl-faq details[open] summary::after { content: "−"; }
  .pl-faq__a { padding: 0 1.1rem 1.1rem; color: var(--color-muted); line-height: 1.7; }

  .pl-band--offer { background: #111827; color: #fff; }
  .pl-offer { display: grid; gap: 2rem; align-items: center; max-width: 980px; margin: 0 auto; }
  @media (min-width: 750px) { .pl-offer { grid-template-columns: .9fr 1.1fr; gap: 3.5rem; } }
  .pl-offer .pl-h2 { color: #fff; }
  .pl-offer__price { display: flex; align-items: baseline; gap: .9rem; flex-wrap: wrap; margin: .25rem 0 .35rem; }
  .pl-offer__now { font-size: clamp(2.2rem, 5vw, 3rem); font-weight: 800; color: #fff; }
  .pl-offer__was { font-size: 1.3rem; opacity: .6; }
  .pl-offer__note { margin: 0 0 .5rem; font-weight: 700; color: var(--color-accent); }
  .pl-offer .pl-checks li { color: rgba(255,255,255,.9); }
  .pl-offer__form { margin-top: 1.5rem; }
  .pl-offer__btn { width: 100%; }
  .pl-offer__sub { margin: .9rem 0 0; font-size: .9rem; opacity: .75; text-align: center; }
</style>

{% schema %}
{
  "name": "דף נחיתה למוצר",
  "class": "section-product-landing",
  "blocks": [
    {
      "type": "split",
      "name": "תמונה + טקסט",
      "settings": [
        { "type": "range", "id": "image_index", "label": "מספר תמונה של המוצר (0 = בלי)", "min": 0, "max": 20, "step": 1, "default": 2 },
        { "type": "checkbox", "id": "reverse", "label": "תמונה בצד השני", "default": false },
        { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false },
        { "type": "text", "id": "eyebrow", "label": "כותרת קטנה" },
        { "type": "text", "id": "heading", "label": "כותרת", "default": "כותרת" },
        { "type": "richtext", "id": "text", "label": "טקסט" },
        { "type": "textarea", "id": "bullets", "label": "רשימה (שורה לכל פריט)" }
      ]
    },
    {
      "type": "steps",
      "name": "איך זה עובד",
      "settings": [
        { "type": "range", "id": "image_index", "label": "מספר תמונה של המוצר (0 = בלי)", "min": 0, "max": 20, "step": 1, "default": 3 },
        { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": true },
        { "type": "text", "id": "eyebrow", "label": "כותרת קטנה" },
        { "type": "text", "id": "heading", "label": "כותרת", "default": "איך זה עובד" },
        { "type": "textarea", "id": "steps", "label": "שלבים (שורה לכל שלב: כותרת | הסבר)" }
      ]
    },
    {
      "type": "compare",
      "name": "טבלת השוואה",
      "settings": [
        { "type": "range", "id": "image_index", "label": "לא בשימוש", "min": 0, "max": 20, "step": 1, "default": 0 },
        { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false },
        { "type": "text", "id": "heading", "label": "כותרת", "default": "מה ההבדל?" },
        { "type": "text", "id": "us_label", "label": "עמודה שלנו", "default": "המוצר" },
        { "type": "text", "id": "them_label", "label": "עמודת החלופה", "default": "החלופה" },
        { "type": "textarea", "id": "rows", "label": "שורות (תכונה | + או - | + או -)" }
      ]
    },
    {
      "type": "tiles",
      "name": "אריחי יתרונות",
      "settings": [
        { "type": "range", "id": "image_index", "label": "לא בשימוש", "min": 0, "max": 20, "step": 1, "default": 0 },
        { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false },
        { "type": "text", "id": "eyebrow", "label": "כותרת קטנה" },
        { "type": "text", "id": "heading", "label": "כותרת", "default": "למה זה עובד" },
        { "type": "textarea", "id": "items", "label": "אריחים (אייקון | כותרת | הסבר)" }
      ]
    },
    {
      "type": "images",
      "name": "שורת תמונות",
      "settings": [
        { "type": "range", "id": "image_index", "label": "לא בשימוש", "min": 0, "max": 20, "step": 1, "default": 0 },
        { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false },
        { "type": "text", "id": "heading", "label": "כותרת" },
        { "type": "text", "id": "indexes", "label": "מספרי תמונות מופרדים בפסיק", "default": "4,5,6" }
      ]
    },
    {
      "type": "specs",
      "name": "מפרט",
      "settings": [
        { "type": "range", "id": "image_index", "label": "לא בשימוש", "min": 0, "max": 20, "step": 1, "default": 0 },
        { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false },
        { "type": "text", "id": "heading", "label": "כותרת", "default": "מפרט" },
        { "type": "textarea", "id": "rows", "label": "שורות (שם | ערך)" }
      ]
    },
    {
      "type": "faq",
      "name": "שאלות ותשובות",
      "settings": [
        { "type": "range", "id": "image_index", "label": "לא בשימוש", "min": 0, "max": 20, "step": 1, "default": 0 },
        { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false },
        { "type": "text", "id": "heading", "label": "כותרת", "default": "שאלות נפוצות" },
        { "type": "textarea", "id": "items", "label": "שאלות (שאלה | תשובה)" }
      ]
    },
    {
      "type": "offer",
      "name": "הצעה + כפתור קנייה",
      "settings": [
        { "type": "range", "id": "image_index", "label": "מספר תמונה של המוצר (0 = בלי)", "min": 0, "max": 20, "step": 1, "default": 1 },
        { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false },
        { "type": "text", "id": "heading", "label": "כותרת", "default": "מוכנים להזמין?" },
        { "type": "text", "id": "price_note", "label": "שורה מתחת למחיר" },
        { "type": "textarea", "id": "bullets", "label": "רשימה (שורה לכל פריט)" },
        { "type": "text", "id": "button_label", "label": "טקסט כפתור", "default": "הזמינו עכשיו" },
        { "type": "text", "id": "subtext", "label": "טקסט מתחת לכפתור" }
      ]
    }
  ],
  "presets": [ { "name": "דף נחיתה למוצר" } ]
}
{% endschema %}
