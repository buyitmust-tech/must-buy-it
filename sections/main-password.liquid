<div class="page-width not-found">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
  <p>האתר יעלה בקרוב! השאירו אימייל ונעדכן אתכם ראשונים.</p>
  {%- form 'customer', class: 'newsletter' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}
      <div class="form-message form-message--success">תודה! נעדכן אותך.</div>
    {%- else -%}
      <div class="newsletter__form"><input class="input" type="email" name="contact[email]" required placeholder="אימייל" aria-label="אימייל"><button type="submit" class="btn btn--primary">עדכנו אותי</button></div>
    {%- endif -%}
  {%- endform -%}
  <details style="margin-top: 3rem;">
    <summary class="muted" style="cursor:pointer;">כניסה עם סיסמה</summary>
    {%- form 'storefront_password', class: 'newsletter' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="newsletter__form"><input class="input" type="password" name="password" placeholder="סיסמה" aria-label="סיסמה"><button type="submit" class="btn btn--dark">כניסה</button></div>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "עמוד סיסמה",
  "settings": []
}
{% endschema %}
