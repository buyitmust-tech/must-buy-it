{%- assign s = section.settings -%}
<section class="section section--tight">
  <div class="page-width">
    <div class="countdown-banner reveal" style="--cd-bg: {{ s.bg }}; --cd-fg: {{ s.fg }};">
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p style="opacity:.9;margin:0;">{{ s.text }}</p>{%- endif -%}
      <div>
        <div class="countdown" data-countdown data-mode="{{ s.mode }}" data-end="{{ s.end_date }}" data-hide-on-end="{{ s.hide_on_end }}">
          {%- if s.mode == 'date' -%}
            <div class="countdown__unit"><span class="countdown__num" data-d>00</span><span class="countdown__label">ימים</span></div>
          {%- endif -%}
          <div class="countdown__unit"><span class="countdown__num" data-h>00</span><span class="countdown__label">שעות</span></div>
          <div class="countdown__unit"><span class="countdown__num" data-m>00</span><span class="countdown__label">דקות</span></div>
          <div class="countdown__unit"><span class="countdown__num" data-s>00</span><span class="countdown__label">שניות</span></div>
        </div>
      </div>
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg btn--pulse">{{ s.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "באנר מבצע עם טיימר",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "🔥 המבצע נגמר בקרוב!" },
    { "type": "text", "id": "text", "label": "טקסט", "default": "עד 50% הנחה על המוצרים הנבחרים — רק היום" },
    {
      "type": "select",
      "id": "mode",
      "label": "סוג טיימר",
      "options": [
        { "value": "evergreen", "label": "מתאפס כל חצות (\"רק היום\")" },
        { "value": "date", "label": "עד תאריך מסוים" }
      ],
      "default": "evergreen"
    },
    { "type": "text", "id": "end_date", "label": "תאריך סיום", "info": "פורמט: 2026-12-31T23:59:00" },
    { "type": "checkbox", "id": "hide_on_end", "label": "הסתר כשהטיימר מסתיים", "default": true },
    { "type": "text", "id": "button_label", "label": "טקסט כפתור", "default": "לניצול ההנחה" },
    { "type": "url", "id": "button_link", "label": "קישור" },
    { "type": "color", "id": "bg", "label": "רקע", "default": "#111827" },
    { "type": "color", "id": "fg", "label": "טקסט", "default": "#ffffff" }
  ],
  "presets": [{ "name": "באנר מבצע עם טיימר" }]
}
{% endschema %}
