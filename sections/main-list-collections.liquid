<div class="page-width section">
  <div class="section-header"><h1>{{ section.settings.heading }}</h1></div>
  <div class="grid" style="--cols: 4; --cols-tablet: 3; --cols-mobile: 2;">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="collection-tile" style="--ratio: 1;">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: collection.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="collection-tile__label">{{ collection.title }} {% render 'icon', name: 'arrow' %}</span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "כל הקולקציות",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "כל הקטגוריות" }
  ]
}
{% endschema %}
