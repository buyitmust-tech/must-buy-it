<div class="page-width section">
  <div class="section-header"><h1>{{ section.settings.heading }}</h1></div>
  <div class="grid collection-grid" style="--cols: 5; --cols-tablet: 4; --cols-mobile: 2;">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' or collection.products_count == 0 -%}
        <div>{%- render 'collection-tile', collection: collection, sizes: '(min-width: 990px) 20vw, (min-width: 750px) 25vw, 50vw' -%}</div>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "כל הקולקציות",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "כל הקטגוריות" }
  ]
}
{% endschema %}
