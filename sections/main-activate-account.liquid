<div class="page-width">
  <div class="customer">
    <h1>הפעלת חשבון</h1>
    <p class="muted">בחרו סיסמה כדי להפעיל את החשבון.</p>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ActPass">סיסמה</label><input type="password" id="ActPass" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ActPass2">אימות סיסמה</label><input type="password" id="ActPass2" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--primary btn--full">הפעלת חשבון</button>
      <button type="submit" name="decline" class="btn btn--secondary btn--full" style="margin-top:.5rem;">דחייה</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "הפעלת חשבון", "settings": [] }
{% endschema %}
