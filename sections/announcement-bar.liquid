{%- if section.blocks.size > 0 -%}
  <div class="announcement" style="--ann-bg: {{ section.settings.bg }}; --ann-fg: {{ section.settings.fg }};" data-announcement data-speed="{{ section.settings.speed }}" role="region" aria-label="הודעות">
    <div class="announcement__track">
      {%- for block in section.blocks -%}
        <div class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "פס הודעות",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "bg", "label": "רקע", "default": "#111827" },
    { "type": "color", "id": "fg", "label": "טקסט", "default": "#ffffff" },
    { "type": "range", "id": "speed", "label": "החלפה כל (שניות)", "min": 2, "max": 10, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "הודעה",
      "settings": [
        { "type": "text", "id": "text", "label": "טקסט", "default": "🚚 משלוח חינם בהזמנה מעל ₪199" },
        { "type": "url", "id": "link", "label": "קישור" }
      ]
    }
  ],
  "presets": [{ "name": "פס הודעות" }]
}
{% endschema %}
