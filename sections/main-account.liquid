<div class="page-width">
  <div class="customer customer--wide">
    <h1>החשבון שלי</h1>
    <p>שלום {{ customer.first_name }} · <a href="{{ routes.account_logout_url }}" class="link">התנתקות</a></p>
    <h2 style="margin-top:2rem;">היסטוריית הזמנות</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <table>
          <thead><tr><th>הזמנה</th><th>תאריך</th><th>תשלום</th><th>משלוח</th><th>סה״כ</th></tr></thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a href="{{ order.customer_url }}" class="link">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p class="muted">עדיין לא ביצעת הזמנות.</p>
      {%- endif -%}
    {%- endpaginate -%}
    <h2 style="margin-top:2rem;">פרטי חשבון</h2>
    {{ customer.default_address | format_address }}
    <p><a href="{{ routes.account_addresses_url }}" class="link">ניהול כתובות ({{ customer.addresses_count }})</a></p>
  </div>
</div>

{% schema %}
{ "name": "חשבון", "settings": [] }
{% endschema %}
