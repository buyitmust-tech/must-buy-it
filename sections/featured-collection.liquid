{%- liquid
  assign s = section.settings
  assign collection = s.collection | default: collections.all
-%}
<section class="section{% if s.alt_bg %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section-header">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
    </div>
    <div class="grid" style="--cols: {{ s.columns }}; --cols-tablet: {{ s.columns | at_most: 3 }}; --cols-mobile: {{ s.columns_mobile }};">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: s.limit -%}
          {% render 'product-card', product: product, ratio: s.ratio, show_vendor: s.show_vendor %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.columns) -%}
          <div class="card">
            <div class="card__media" style="--ratio: 1;">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="card__info"><h3 class="card__title">שם המוצר</h3><div class="price"><span class="price__current">₪99.90</span></div></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if s.show_view_all and collection != blank -%}
      <div class="text-center" style="margin-top: 2rem;">
        <a href="{{ collection.url }}" class="btn btn--secondary">{{ s.view_all_label }} {% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "קולקציה מובלטת",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "כותרת קטנה", "default": "הכי נמכרים" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "המוצרים שכולם מדברים עליהם" },
    { "type": "text", "id": "text", "label": "טקסט" },
    { "type": "collection", "id": "collection", "label": "קולקציה" },
    { "type": "range", "id": "limit", "label": "מספר מוצרים", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "עמודות בדסקטופ", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "עמודות במובייל", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "2" },
    { "type": "select", "id": "ratio", "label": "יחס תמונה", "options": [ { "value": "1", "label": "ריבוע" }, { "value": "0.8", "label": "לאורך" }, { "value": "1.25", "label": "לרוחב" } ], "default": "1" },
    { "type": "checkbox", "id": "show_vendor", "label": "הצג מותג", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "הצג כפתור \"לכל המוצרים\"", "default": true },
    { "type": "text", "id": "view_all_label", "label": "טקסט כפתור", "default": "לכל המוצרים" },
    { "type": "checkbox", "id": "alt_bg", "label": "רקע משני", "default": false }
  ],
  "presets": [{ "name": "קולקציה מובלטת" }]
}
{% endschema %}
