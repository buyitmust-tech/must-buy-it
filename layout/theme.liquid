<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="rtl">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; עמוד {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {%- assign heading_font = settings.type_heading_font -%}
    {%- assign body_font = settings.type_body_font -%}
    {%- assign body_font_bold = body_font | font_modify: 'weight', 'bold' -%}
    {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}

    {% style %}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}

      :root {
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-weight: {{ body_font.weight }};

        --color-bg: {{ settings.color_background }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-text: {{ settings.color_text }};
        --color-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-hover: {{ settings.color_accent | color_darken: 8 }};
        --color-accent-contrast: {{ settings.color_accent_text }};
        --color-sale: {{ settings.color_sale }};
        --color-success: {{ settings.color_success }};
        --color-border: rgba(var(--color-text-rgb), 0.12);
        --color-muted: rgba(var(--color-text-rgb), 0.65);

        --radius: {{ settings.border_radius }}px;
        --radius-btn: {{ settings.button_radius }}px;
        --page-width: {{ settings.page_width }}px;
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | times: 100 | json }},
        cartType: {{ settings.cart_type | json }},
        strings: {
          addToCart: "הוספה לסל",
          soldOut: "אזל מהמלאי",
          unavailable: "לא זמין",
          adding: "מוסיף...",
          added: "נוסף לסל ✓"
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link visually-hidden" href="#MainContent">דלג לתוכן</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div class="drawer drawer--end cart-drawer" id="CartDrawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="סל הקניות">
      <div class="drawer__overlay" data-close-drawer></div>
      <div class="drawer__panel">
        {% section 'cart-drawer-content' %}
      </div>
    </div>

    {%- if settings.whatsapp_number != blank -%}
      {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
      <a
        class="whatsapp-float"
        href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}"
        target="_blank"
        rel="noopener"
        aria-label="שלחו לנו הודעה בוואטסאפ"
      >
        {% render 'icon', name: 'whatsapp' %}
      </a>
    {%- endif -%}

    {%- if settings.show_sales_popup and template.name != 'cart' -%}
      <div class="sales-pop" id="SalesPop" hidden aria-live="polite">
        <div class="sales-pop__img"></div>
        <div class="sales-pop__body">
          <span class="sales-pop__who"></span>
          <strong class="sales-pop__what"></strong>
          <span class="sales-pop__when"></span>
        </div>
        <button type="button" class="sales-pop__close" aria-label="סגור">&times;</button>
      </div>
      <script type="application/json" id="SalesPopData">
        {
          "names": {{ settings.sales_popup_names | split: ',' | json }},
          "cities": {{ settings.sales_popup_cities | split: ',' | json }},
          "products": [
            {%- assign pop_collection = settings.sales_popup_collection | default: collections.all -%}
            {%- for product in pop_collection.products limit: 12 -%}
              { "title": {{ product.title | json }}, "url": {{ product.url | json }}, "image": {{ product.featured_image | image_url: width: 120 | json }} }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </body>
</html>
