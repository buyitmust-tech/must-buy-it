<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="rtl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- assign body_font = settings.type_body_font -%}
    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      :root {
        --font-heading: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --color-bg: {{ settings.color_background }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-text: {{ settings.color_text }};
        --color-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-hover: {{ settings.color_accent | color_darken: 8 }};
        --color-accent-contrast: {{ settings.color_accent_text }};
        --color-border: rgba(var(--color-text-rgb), 0.12);
        --color-muted: rgba(var(--color-text-rgb), 0.65);
        --radius: {{ settings.border_radius }}px;
        --radius-btn: {{ settings.button_radius }}px;
        --page-width: {{ settings.page_width }}px;
      }
    {% endstyle %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
