{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="rtl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>כרטיס מתנה — {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>:root { --color-accent: {{ settings.color_accent }}; --color-accent-contrast: {{ settings.color_accent_text }}; --color-text: {{ settings.color_text }}; --color-bg: #fff; --color-bg-alt: #f6f6f8; --color-border: #e5e7eb; --color-muted: #6b7280; --radius: 12px; --radius-btn: 10px; --page-width: 720px; --font-body: system-ui, sans-serif; --font-heading: system-ui, sans-serif; }</style>
    {{ content_for_header }}
  </head>
  <body>
    <main class="page-width not-found">
      <h1>{{ shop.name }}</h1>
      <p class="muted">כרטיס המתנה שלך</p>
      <div class="price price--lg" style="justify-content:center;"><span class="price__current">{% render 'money', cents: gift_card.balance %}</span></div>
      {%- if gift_card.enabled == false or gift_card.expired -%}<p class="form-message form-message--error">כרטיס המתנה אינו פעיל</p>{%- endif -%}
      <p style="font-size:1.5rem;font-weight:800;letter-spacing:.1em;direction:ltr;">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.expires_on -%}<p class="muted">בתוקף עד {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>{%- endif -%}
      <div style="margin: 1.5rem auto; width: 160px;" id="QrCode"></div>
      <p><a href="{{ shop.url }}" class="btn btn--primary">לקנייה בחנות</a></p>
      {%- if gift_card.pass_url -%}<p><a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" loading="lazy" style="margin:0 auto;"></a></p>{%- endif -%}
      <p><button class="btn btn--secondary" onclick="window.print();">הדפסה</button></p>
    </main>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script>window.addEventListener('load', function () { if (window.QRCode) new QRCode(document.getElementById('QrCode'), { text: '{{ gift_card.qr_identifier }}', width: 160, height: 160 }); });</script>
  </body>
</html>
